# Koneksi PostgreSQL (wajib). Ganti PASSWORD sesuai server Anda.
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/masjid_display

# Untuk Docker Compose: gunakan password acak alfanumerik agar aman dalam URL.
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_ACAK

# Password awal akun "admin" (dipakai hanya saat database pertama kali dibuat).
# Segera ganti dari Pengaturan > Ganti password saya setelah login.
ADMIN_INITIAL_PIN=GANTI_DENGAN_KODE_UNIK_YANG_KUAT

# Folder penyimpanan gambar upload (poster, QRIS, logo).
UPLOAD_DIR=./data/uploads

# Isi 1 hanya jika aplikasi diakses tanpa HTTPS (mis. uji di jaringan lokal).
# INSECURE_COOKIE=1

# Simulasi data contoh di /demo, tanpa PostgreSQL. Nonaktifkan untuk operasional.
DEMO_MODE=0

# Siaran kamera masjid (WebRTC). Tanpa pengaturan, STUN memakai stun:stun.l.google.com:19302.
# Kosongkan (STUN_URLS=) bila server dan perangkat tidak terhubung ke internet.
# STUN_URLS=stun:stun.l.google.com:19302

# TURN diperlukan bila jaringan memblokir koneksi langsung antarperangkat (client isolation).
# Pisahkan beberapa alamat dengan koma. Untuk coturn dengan use-auth-secret, isi TURN_SECRET
# sama dengan static-auth-secret; atau isi TURN_USERNAME dan TURN_CREDENTIAL untuk akun tetap.
# TURN_URLS=turn:turn.example.ac.id:3478?transport=udp,turn:turn.example.ac.id:3478?transport=tcp
# TURN_SECRET=GANTI_DENGAN_RAHASIA_COTURN
# TURN_USERNAME=
# TURN_CREDENTIAL=
